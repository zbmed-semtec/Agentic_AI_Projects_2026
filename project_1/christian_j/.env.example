# Copy this file to .env and edit the values for your machine:
#   cp .env.example .env

# ollama  |  openai_compatible (LM Studio, llama.cpp server, vLLM, etc.)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2

# Used when LLM_PROVIDER=ollama
# Model name must match `ollama list` (do not add the ollama/ prefix here).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Used when LLM_PROVIDER=openai_compatible
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_MODEL_NAME=local-model
OPENAI_API_KEY=local
